# Stripe
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Sanity (write access for order creation via webhook)
SANITY_WRITE_TOKEN=skXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Resend (transactional emails)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=Comic Strip Canvas <orders@comicstripcanvas.co.uk>
TEAM_EMAIL=your-production-team@email.com

# Site URL (Netlify sets this automatically, fallback for local dev)
SITE_URL=https://comicstripcanvas.co.uk

# Cloudflare Turnstile (contact-form anti-spam)
# TURNSTILE_SITE_KEY is public and is baked into the page at BUILD time, so a
# change to it needs a rebuild. TURNSTILE_SECRET_KEY is read by
# netlify/functions/contact.mts at request time and must never reach the client.
# Cloudflare's documented always-passes test pair is fine for local dev:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=0xXXXXXXXXXXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
