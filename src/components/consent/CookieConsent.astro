---
// src/components/consent/CookieConsent.astro
//
// Cookie banner + consent logic (see cookie-consent.ts). Place it as the
// FIRST element inside <body> so keyboard and screen-reader users reach it
// first; it is shown fixed at the bottom of the screen, so it never shifts
// page content. Hidden until the script decides it is needed.
//
// Usage:
//   <CookieConsent gtm="GTM-…" policyUrl="/privacy-policy/" cookieName="csc_consent" />
// and put  <button type="button" data-cookie-settings>Cookie settings</button>
// in the footer. Colours come from the --cc-* custom properties below.
interface Props {
  ga4?: string;
  metaPixel?: string;
  /** Google Tag Manager container id; the whole container waits for consent. */
  gtm?: string;
  policyUrl?: string;
  cookieName?: string;
  /** What the optional cookies are for, in one short line. */
  purpose?: string;
}
const {
  ga4,
  metaPixel,
  gtm,
  policyUrl = '/cookie-policy',
  cookieName = 'site_consent',
  purpose = 'We’d like to use analytics and advertising cookies to see how the site is used and measure our ads. They stay off unless you accept.',
} = Astro.props;
---

<section
  id="cookie-consent"
  class="cc"
  aria-labelledby="cc-title"
  aria-describedby="cc-desc"
  data-ga4={ga4}
  data-meta-pixel={metaPixel}
  data-gtm={gtm}
  data-cookie-name={cookieName}
  hidden
>
  <div class="cc__inner">
    <div class="cc__copy">
      <h2 id="cc-title" class="cc__title">Your cookie choices</h2>
      <p id="cc-desc" class="cc__text">
        {purpose} <a href={policyUrl} class="cc__link">Read our privacy policy</a>
      </p>
      <p class="cc__status" data-cc-status hidden></p>
    </div>
    <div class="cc__actions">
      <button type="button" class="cc__btn" data-cc-accept>Accept all</button>
      <button type="button" class="cc__btn" data-cc-reject>Reject all</button>
    </div>
  </div>
</section>
<div id="cookie-consent-announcer" class="cc__sr" aria-live="polite"></div>

<script>
  import { initCookieConsent } from './cookie-consent';
  initCookieConsent();
</script>

<style>
  /* Comic Strip Canvas: black panel, magenta border, hard comic shadow. */
  .cc {
    --cc-bg: #1a1a1a;
    --cc-fg: #f5f5f5;
    --cc-muted: #d1d5db;
    --cc-border: #ec008c;
    --cc-accent: #fff200;
    --cc-accent-fg: #000000;
    --cc-link: #00aeef;
    position: fixed;
    inset: auto 0 0 0;
    z-index: 1000;
    padding: 0 16px calc(16px + env(safe-area-inset-bottom));
    pointer-events: none;
    font-family: 'Source Sans 3', system-ui, sans-serif;
  }
  .cc[hidden] { display: none; }
  .cc__inner {
    pointer-events: auto;
    max-width: 960px;
    margin: 0 auto;
    background: var(--cc-bg);
    color: var(--cc-fg);
    border: 3px solid var(--cc-border);
    box-shadow: 6px 6px 0 #000;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cc__title {
    margin: 0 0 6px;
    font-family: 'Russo One', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .cc__text, .cc__status { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--cc-muted); }
  .cc__status { margin-top: 6px; color: var(--cc-fg); }
  .cc__link { color: var(--cc-link); text-decoration: underline; text-underline-offset: 2px; }
  .cc__link:hover { color: var(--cc-accent); }
  .cc__actions { display: flex; gap: 12px; }
  /* Both buttons share one style: equal prominence. */
  .cc__btn {
    flex: 1 1 0;
    min-height: 44px;
    padding: 10px 20px;
    border: 2px solid #000;
    background: var(--cc-accent);
    color: var(--cc-accent-fg);
    box-shadow: 3px 3px 0 var(--cc-border);
    font-family: 'Russo One', system-ui, sans-serif;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
  }
  .cc__btn:hover { filter: brightness(1.06); }
  .cc__btn:focus-visible, .cc__link:focus-visible {
    outline: 3px solid var(--cc-link);
    outline-offset: 3px;
  }
  .cc__sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (min-width: 768px) {
    .cc__inner { flex-direction: row; align-items: center; gap: 24px; padding: 20px 24px; }
    .cc__copy { flex: 1 1 auto; }
    .cc__actions { flex: 0 0 auto; }
    .cc__btn { flex: 0 0 9.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cc__inner { animation: cc-in 0.2s ease-out; }
    @keyframes cc-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  }
</style>
