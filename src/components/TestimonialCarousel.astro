---
interface Testimonial {
  _id: string;
  customerName: string;
  location: string;
  rating: number;
  quote: string;
  product: string;
}

interface Props {
  testimonials?: Testimonial[];
}

// Accept Sanity data as props, fall back to empty array
const { testimonials = [] } = Astro.props;
---

<section class="py-16 bg-black overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <div class="text-center reveal">
      <div class="kapow-badge mb-4">Happy Customers</div>
      <h2 class="section-heading">WHAT OUR CUSTOMERS SAY</h2>
    </div>
  </div>

  <div class="relative testimonial-viewport">
    <div id="testimonial-track" class="flex gap-6 testimonial-scroll" style="width: max-content;">
      {[...testimonials, ...testimonials].map((t, i) => (
        <div class={`w-80 flex-shrink-0 bg-panel-dark border-4 border-black p-6 ${i >= testimonials.length ? 'testimonial-dup' : ''}`}
             aria-hidden={i >= testimonials.length ? 'true' : undefined}
             style="box-shadow: 4px 4px 0 #000000;">
          <div class="flex gap-1 mb-4">
            {Array(t.rating).fill(null).map(() => (
              <svg class="w-5 h-5 text-comic-yellow" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="font-source text-gray-300 text-sm leading-relaxed mb-5 italic">
            &ldquo;{t.quote}&rdquo;
          </blockquote>
          <div class="border-t-2 border-gray-700 pt-4">
            <p class="font-russo text-off-white text-sm">{t.customerName}</p>
            <p class="font-source text-gray-500 text-xs">{t.location}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 text-center testimonial-controls">
    <button type="button" id="testimonial-pause" class="font-russo text-xs uppercase tracking-wider text-gray-400 hover:text-comic-yellow border-2 border-gray-700 px-3 py-1.5" aria-pressed="false">
      Pause scrolling
    </button>
  </div>
</section>

<script>
  // The marquee runs for more than 5 seconds, so it gets a pause control.
  const btn = document.getElementById('testimonial-pause');
  const track = document.getElementById('testimonial-track');
  btn?.addEventListener('click', () => {
    const paused = track?.classList.toggle('is-paused') ?? false;
    btn.setAttribute('aria-pressed', String(paused));
    btn.textContent = paused ? 'Resume scrolling' : 'Pause scrolling';
  });
</script>

<style>
  .testimonial-scroll {
    animation: scroll-left 30s linear infinite;
  }

  .testimonial-scroll:hover,
  .testimonial-scroll:focus-within,
  .testimonial-scroll.is-paused {
    animation-play-state: paused;
  }

  /* Reduced motion: no marquee. The cards sit in a row you can scroll. */
  @media (prefers-reduced-motion: reduce) {
    .testimonial-scroll { animation: none; }
    .testimonial-dup { display: none; }
    .testimonial-viewport { overflow-x: auto; padding: 0 1rem; }
    .testimonial-controls { display: none; }
  }

  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
