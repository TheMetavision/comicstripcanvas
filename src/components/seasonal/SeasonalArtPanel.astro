---
/* Phones (< 768px): the seasonal art as its own 4:5 comic panel below the
   hero text, so no text ever sits on it. Wrap it in .season-on. Desktops
   hide it and get a transparent GIF instead, so they never download it. */
import { sanitySrcset, sanityImg } from '../../lib/sanityImage';
import type { SeasonalImage } from '../../lib/seasonal';

interface Props {
  image: SeasonalImage;
  alt: string;
}
const { image, alt } = Astro.props;
const pos = image.hotspot ? `${Math.round(image.hotspot.x * 100)}% ${Math.round(image.hotspot.y * 100)}%` : '50% 50%';
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---
<picture>
  <source media="(min-width: 768px)" srcset={BLANK} />
  <img
    src={sanityImg(image.url, 767)}
    srcset={sanitySrcset(image.url, 767)}
    sizes="(max-width: 767px) calc(100vw - 32px), 1px"
    width="800"
    height="1000"
    alt={alt}
    loading="eager"
    decoding="async"
    class="block w-full h-auto aspect-[4/5] object-cover border-4 border-black"
    style={`object-position: ${pos};`}
  />
</picture>
