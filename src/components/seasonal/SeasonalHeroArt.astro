---
/* Full-bleed seasonal hero art for tablets and desktops (>= 768px), plus the
   scrim that keeps the hero text legible on it. Absolutely positioned: place
   it inside the hero after its default backgrounds and wrap it in .season-on.
   Phones never get this art or scrim: there the text sits on the default
   charcoal background and the art follows it as its own panel
   (SeasonalArtPanel). */
import { sanityImg, sanitySrcset } from '../../lib/sanityImage';
import type { SeasonalCampaign } from '../../lib/seasonal';

interface Props {
  campaign: SeasonalCampaign;
}
const { campaign } = Astro.props;
const desktop = campaign.heroImageDesktop;

// A hotspot set in Studio wins; otherwise right centre (the text sits left).
const pos = desktop.hotspot
  ? `${Math.round(desktop.hotspot.x * 100)}% ${Math.round(desktop.hotspot.y * 100)}%`
  : '100% 50%';
const dims = desktop.width && desktop.height ? { width: 1920, height: Math.round((1920 * desktop.height) / desktop.width) } : {};
// A 1x1 transparent GIF for phones, so they never download the desktop art.
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---
<div class="seasonal-art" style={`--pos-d: ${pos};`}>
  <picture>
    <source media="(max-width: 767px)" srcset={BLANK} />
    <img
      src={sanityImg(desktop.url, 1920)}
      srcset={sanitySrcset(desktop.url, 1920)}
      sizes="100vw"
      {...dims}
      alt={campaign.heroImageAlt}
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="seasonal-scrim"></div>
</div>

<!-- is:inline: emitted only when this renders, never into the shared CSS bundle. -->
<style is:inline>
  .seasonal-art {
    display: none;
  }
  @media (min-width: 768px) {
    .seasonal-art {
      display: block;
      position: absolute;
      inset: 0;
    }
    .seasonal-art img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--pos-d);
    }
    /* Solid behind the text column, whose glyphs end at most at 637px or
       50% + 13px (measured 768-1920px wide with two short headline lines),
       then fading out over the art on the right. 0.60 with grey-300 text was
       checked against the real Christmas art. */
    .seasonal-scrim {
      --solid: max(680px, calc(50% + 40px));
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(17, 17, 17, 0.6) 0, rgba(17, 17, 17, 0.6) var(--solid), rgba(17, 17, 17, 0) calc(var(--solid) + 15%));
    }
    /* Over the art the trust row goes from grey-400 to grey-300 (#D1D5DB). */
    html[data-season="on"] .season-trust .text-gray-400 {
      color: #d1d5db;
    }
  }
</style>
