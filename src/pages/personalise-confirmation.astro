---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

// M4: verify the real payment state server-side (Stripe is authoritative).
// No Sanity access here, so this stays correct once the dataset goes private.
const sessionId = Astro.url.searchParams.get('session_id');

let state = 'error'; // 'paid' | 'pending' | 'error'
if (sessionId) {
  try {
    const res = await fetch(
      `https://api.stripe.com/v1/checkout/sessions/${encodeURIComponent(sessionId)}`,
      { headers: { Authorization: `Bearer ${process.env.STRIPE_SECRET_KEY}` } }
    );
    if (res.ok) {
      const session = await res.json();
      state = session.payment_status === 'paid' ? 'paid' : 'pending';
    }
  } catch (err) {
    console.error('personalise-confirmation verify failed:', err?.message);
  }
}
---

<BaseLayout
  title={state === 'paid' ? 'Custom Order Confirmed' : 'Order Status'}
  description="Your personalised Comic Strip Canvas order status."
  noindex={true}
>
  <section class="relative bg-charcoal py-20 min-h-[60vh]">
    <div class="absolute inset-0 halftone-bg opacity-40"></div>
    <div class="absolute top-0 left-0 right-0 h-1 bg-comic-cyan"></div>
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 relative text-center">
      {state === 'paid' && (
        <div>
          <div class="speech-bubble inline-block mb-8 text-lg">YOU'RE THE HERO!</div>
          <h1 class="font-bangers text-5xl md:text-7xl text-off-white tracking-wide mb-6"
              style="text-shadow: 4px 4px 0 rgba(0,0,0,0.5);">
            CUSTOM ORDER <span class="text-comic-cyan">RECEIVED!</span>
          </h1>
          <p class="font-source text-gray-300 text-lg leading-relaxed mb-8 max-w-lg mx-auto">
            Thank you for your personalised order! Our artists are about to get to work. Here's what happens next.
          </p>
          <div class="bg-panel-dark border-4 border-black p-8 text-left mb-8" style="box-shadow: 5px 5px 0 #000;">
            <h2 class="font-russo text-off-white text-sm uppercase tracking-wide mb-4 pb-3 border-b-2 border-gray-700">
              Your Personalised Order Timeline
            </h2>
            <div class="space-y-4">
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-comic-cyan border-2 border-black flex items-center justify-center flex-shrink-0 font-bangers text-black">1</div>
                <div>
                  <p class="font-russo text-off-white text-sm">Order Received</p>
                  <p class="font-source text-gray-400 text-xs">Payment confirmed. Your photos are with our artists.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-comic-cyan border-2 border-black flex items-center justify-center flex-shrink-0 font-bangers text-black">2</div>
                <div>
                  <p class="font-russo text-off-white text-sm">Artwork Creation</p>
                  <p class="font-source text-gray-400 text-xs">Our artists hand-create your custom comic artwork from your photos.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-panel-dark border-2 border-gray-600 flex items-center justify-center flex-shrink-0 font-bangers text-gray-500">3</div>
                <div>
                  <p class="font-russo text-gray-400 text-sm">Print &amp; Dispatch</p>
                  <p class="font-source text-gray-500 text-xs">We print and dispatch your order within 7-10 working days, then email your tracking.</p>
                </div>
              </div>
            </div>
            <div class="mt-6 pt-4 border-t-2 border-gray-700">
              <p class="font-source text-gray-400 text-xs">
                <strong class="text-comic-cyan">Check your email</strong> — we've sent a confirmation with all your order details.
              </p>
            </div>
          </div>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/store" class="btn-primary">BROWSE MORE ART</a>
            <a href="/contact" class="btn-secondary">GOT A QUESTION?</a>
          </div>
        </div>
      )}

      {state === 'pending' && (
        <div>
          <div class="speech-bubble inline-block mb-8 text-lg">HANG TIGHT!</div>
          <h1 class="font-bangers text-5xl md:text-7xl text-off-white tracking-wide mb-6"
              style="text-shadow: 4px 4px 0 rgba(0,0,0,0.5);">
            PAYMENT <span class="text-comic-cyan">PROCESSING</span>
          </h1>
          <p class="font-source text-gray-300 text-lg leading-relaxed mb-8 max-w-lg mx-auto">
            Your payment is still being processed — this can take a little longer with methods like Klarna.
            As soon as it clears we'll email your confirmation and our artists will get started. There's no need to pay again.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/store" class="btn-primary">BROWSE MORE ART</a>
            <a href="/contact" class="btn-secondary">GOT A QUESTION?</a>
          </div>
        </div>
      )}

      {state === 'error' && (
        <div>
          <h1 class="font-bangers text-4xl text-off-white tracking-wide mb-4">SOMETHING WENT WRONG</h1>
          <p class="font-source text-gray-300 mb-6">We couldn't verify your order details, but don't worry — if payment was taken, your order is safe and we've emailed your confirmation.</p>
          <a href="/contact" class="btn-primary">CONTACT US</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
