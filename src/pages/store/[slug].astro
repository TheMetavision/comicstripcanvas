---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import { allProductSlugsQuery, productBySlugQuery } from '../../lib/queries';
import { PRICES, FORMAT_LABELS, SIZES, ARTWORK_STYLES } from '../../data/products';
/* The one place the customise fee is decided. Imported across the src/netlify
   line on purpose: this module is plain constants with no imports of its own,
   and a second copy of a PRICE is how a displayed number and a charged one
   come to disagree. */
import { CUSTOMISE_FEE_DEFAULT } from '../../../netlify/functions/_shared/artwork-styles.mjs';
import ProductBuilder from '../../components/ProductBuilder.astro';
import type { ProductFormat, ProductSize } from '../../data/products';

export async function getStaticPaths() {
  const products = await sanityClient.fetch(allProductSlugsQuery);
  return products.map((product: any) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = await sanityClient.fetch(productBySlugQuery, { slug });

if (!product) {
  return Astro.redirect('/store');
}

const categoryLinks: Record<string, string> = {
  'comic-book-covers': '/store/comic-book-covers',
  'comic-book-icons': '/store/comic-book-icons',
  'comic-book-strips': '/store/comic-book-strips',
  'personalised': '/store/personalised',
};

const categoryLabels: Record<string, string> = {
  'comic-book-covers': 'Comic Book Covers',
  'comic-book-icons': 'Comic Book Icons',
  'comic-book-strips': 'Comic Book Strips',
  'personalised': 'Personalised',
};

const basePrice = PRICES.poster.small;
const hasImages = product.images && product.images.length > 0;
const mainImageUrl = hasImages && product.images[0]?.asset
  ? urlFor(product.images[0]).width(800).url()
  : null;

/* A SECOND artwork style, when the product has one.

   images[0] is the Classic style and always has been -- there is no classic
   object on the document, because every product predates the idea. The second
   style is an optional fullBleed slot, and a product without one shows no
   choice at all: 292 of them have exactly one style and a selector offering a
   choice of one is worse than no selector.

   Classic stays the default everywhere it matters. It is what the page renders
   first, what the Open Graph image and the Product schema describe, and what
   the shopping feed lists -- the feed reads images[0] and knows nothing about
   this. */
/* Which styles can be reopened in the builder. A design drawn in the studio
   has a scene behind it; a hand-curated product has a photograph somebody
   uploaded years ago and nothing to reopen, so it is offered nothing. */
const customisable = {
  classic: !!product.classicSceneId,
  fullBleed: !!product.fullBleed?.sceneId,
};
const canCustomise = !product.isPersonalised && (customisable.classic || customisable.fullBleed);
/* WHICH style the link opens, decided here rather than left to the browser.

   The button is offered when EITHER style has a scene, and the two are not
   interchangeable: this product may have been drawn full bleed and never
   classic. So the server-rendered href names a style that actually has a scene
   -- classic when there is one, full bleed otherwise -- and a customer who
   never touches the style buttons cannot be sent to a design that does not
   exist. Before this it always opened classic, which for a full-bleed-only
   product is a guaranteed blank builder. */
const customiseStyle = customisable.classic ? 'classic' : (customisable.fullBleed ? 'fullBleed' : null);
const customiseHref = customiseStyle
  ? `/store/${product.slug}/customise${customiseStyle === 'fullBleed' ? '?style=fullbleed' : ''}`
  : null;
/* In pence on the document, because a £5 fee is honestly a whole number of
   them. Absent on almost everything, so the shared default is the ordinary
   answer -- and it is the same one checkout resolves to. */
const customiseFee = typeof product.customiseFee === 'number' && product.customiseFee > 0
  ? product.customiseFee
  : CUSTOMISE_FEE_DEFAULT;

const fullBleedImage = product.fullBleed?.listingImage?.asset
  ? urlFor(product.fullBleed.listingImage).width(800).url()
  : null;
const hasStyleChoice = !!fullBleedImage && !product.isPersonalised;
/* What each style does to the photograph, on the buttons themselves.

   Page-local rather than in ARTWORK_STYLES: that map is the two NAMES, which
   the cart drawer and the functions share, and this is a sentence about the
   artwork that only the product page has room for. The builder's own switcher
   says the same thing in its own words for someone who is making one. */
const STYLE_HINTS: Record<string, string> = {
  classic: 'Cut-out figure on a comic burst background, framed by the masthead and captions',
  fullBleed: 'Edge-to-edge artwork with the masthead and captions laid over it',
};

const styleImages = {
  classic: { url: mainImageUrl, alt: product.images?.[0]?.alt || product.title },
  fullBleed: {
    url: fullBleedImage,
    alt: product.fullBleed?.listingImage?.alt || `${product.title} — full bleed`,
  },
};

// The three personalised products each open the builder on their own template.
// Orientation and full-bleed variants are switches inside the builder itself.
const BUILDER_TEMPLATE: Record<string, 'strip' | 'cover' | 'icon-portrait'> = {
  'personalised-strips': 'strip',
  'personalised-book-covers': 'cover',
  'personalised-icons': 'icon-portrait',
};
const builderTemplate = BUILDER_TEMPLATE[product.slug];

// The fee comes from Sanity, the same field checkout.mjs prices from. A build
// that mounts the builder without one is a build that would display a price it
// cannot charge, so stop rather than guess.
const personalisationFee = product.personalisationFee;
if (builderTemplate && (typeof personalisationFee !== 'number' || !Number.isFinite(personalisationFee))) {
  throw new Error(
    `Product "${product.slug}" mounts the builder but has no personalisationFee in Sanity ` +
    `(got ${JSON.stringify(personalisationFee)}). Set it on the product document.`
  );
}
const personalisedFrom =
  personalisationFee !== undefined ? PRICES.poster.small + personalisationFee : undefined;

const relatedProducts = product.relatedProducts || [];
const seoTitle = product.seo?.metaTitle || product.title;
const seoDesc = product.seo?.metaDescription || product.description;
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  ogType="product"
>
  <section class="relative bg-charcoal py-8">
    <div class="absolute top-0 left-0 right-0 h-1 bg-comic-red"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 font-source text-sm text-gray-500 mb-8">
        <a href="/" class="hover:text-comic-yellow transition-colors">Home</a>
        <span>/</span>
        <a href="/store" class="hover:text-comic-yellow transition-colors">Store</a>
        <span>/</span>
        <a href={categoryLinks[product.category]} class="hover:text-comic-yellow transition-colors">
          {categoryLabels[product.category]}
        </a>
        <span>/</span>
        <span class="text-off-white truncate">{product.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
        <!-- Image Column -->
        <div>
          <div id="main-image"
               class="bg-mid-grey border-4 border-black mb-4 overflow-hidden flex items-center justify-center cursor-pointer"
               style="box-shadow: 6px 6px 0 #000000; min-height: 400px; max-height: 600px;">
            {mainImageUrl ? (
              <img
                src={mainImageUrl}
                alt={product.images[0]?.alt || product.title}
                class="max-w-full max-h-[580px] object-contain"
                id="main-product-img"
              />
            ) : (
              <span class="text-gray-500 font-russo tracking-widest text-xs uppercase">PRODUCT IMAGE</span>
            )}
          </div>
          {hasImages && product.images.length > 1 && (
            <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-thin">
              {product.images.map((img: any, i: number) => {
                const thumbUrl = img?.asset ? urlFor(img).width(160).height(128).url() : null;
                return thumbUrl ? (
                  <button
                    class="w-20 h-16 flex-shrink-0 border-2 border-gray-700 cursor-pointer hover:border-comic-yellow transition-colors overflow-hidden bg-mid-grey flex items-center justify-center thumb-btn"
                    data-full={urlFor(img).width(1200).url()}
                    data-alt={img.alt || product.title}
                  >
                    <img src={thumbUrl} alt={img.alt || `${product.title} view ${i + 1}`} class="max-w-full max-h-full object-contain" />
                  </button>
                ) : null;
              })}
            </div>
          )}
          {(!hasImages || product.images.length <= 1) && (
            <div class="flex gap-3">
              {[1, 2, 3].map((i) => (
                <div class="w-20 h-16 img-placeholder border-2 border-gray-700">
                  <span class="text-gray-600 text-xs font-russo">IMG {i}</span>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Product Info Column -->
        <div>
          {product.isPersonalised && (
            <div class="inline-block bg-comic-yellow text-black font-comic font-bold text-xs px-3 py-1 border-2 border-black mb-4">
              PERSONALISED
            </div>
          )}
          <h1 class="font-bangers text-4xl lg:text-5xl text-off-white tracking-wide mb-3"
              style="text-shadow: 3px 3px 0 rgba(0,0,0,0.4);">
            {product.title}
          </h1>

          {product.isPersonalised && personalisedFrom !== undefined ? (
            <Fragment>
              {/* The builder owns format, size and the artwork fee here, so this is a
                  static "from" price. Deliberately no id="current-price": that is the
                  hook updatePrice() writes to, and it must not flatten this copy. */}
              <div class="price-tag text-3xl mb-1">From £{personalisedFrom.toFixed(2)}</div>
              <p class="font-source text-gray-400 text-sm mb-4">
                Posters from £{PRICES.poster.small.toFixed(2)}, canvas from £{PRICES['canvas-standard'].small.toFixed(2)},
                plus £{personalisationFee} personalisation. Choose your size and format in the builder.
              </p>
            </Fragment>
          ) : (
            <Fragment>
              <div id="current-price" class="price-tag text-3xl mb-4">
                From £{basePrice.toFixed(2)}
              </div>
              <p class="font-source text-gray-400 text-sm mb-4">Posters from £9.99 &middot; Canvas from £26.99 &mdash; choose your format below</p>
            </Fragment>
          )}

          <p class="font-source text-gray-300 leading-relaxed text-base mb-8">{product.description}</p>

          {/* Personalised products are configured and priced in the builder below,
             which owns format, size and the artwork fee. Showing the standard
             purchase block here would let one be bought with no layout and no fee. */}
          {!product.isPersonalised && (
            <Fragment>
            {hasStyleChoice && (
              <div class="mb-6">
                <h3 class="font-russo text-off-white text-sm uppercase tracking-wide mb-3">Style</h3>
                <div class="grid grid-cols-2 gap-2">
                  {(Object.entries(ARTWORK_STYLES) as [string, string][]).map(([key, label]) => (
                    <button
                      class="style-btn border-4 border-black bg-panel-dark py-3 px-2 text-center font-source text-xs text-gray-300 hover:border-comic-yellow hover:text-off-white transition-all"
                      data-style={key}
                      title={STYLE_HINTS[key]}
                      aria-description={STYLE_HINTS[key]}
                      style="box-shadow: 2px 2px 0 #000;">
                      {label}
                    </button>
                  ))}
                </div>
                <p class="font-source text-gray-400 text-xs mt-2">
                  Available in two styles &mdash; pick the one that suits your wall.
                </p>
              </div>
            )}

            <!-- Format Selector -->
            <div class="mb-6">
              <h3 class="font-russo text-off-white text-sm uppercase tracking-wide mb-3">Print Format</h3>
              <div class="grid grid-cols-3 gap-2">
                {(Object.entries(FORMAT_LABELS) as [ProductFormat, string][]).map(([key, label]) => (
                  <button
                    class="format-btn border-4 border-black bg-panel-dark py-3 px-2 text-center font-source text-xs text-gray-300 hover:border-comic-yellow hover:text-off-white transition-all"
                    data-format={key}
                    style="box-shadow: 2px 2px 0 #000;">
                    {label}
                  </button>
                ))}
              </div>
            </div>

            <!-- Size Selector -->
            <div class="mb-6">
              <h3 class="font-russo text-off-white text-sm uppercase tracking-wide mb-3">Size</h3>
              <div class="grid grid-cols-3 gap-2">
                {(Object.entries(SIZES) as [ProductSize, string][]).map(([key, label]) => (
                  <button
                    class="size-btn border-4 border-black bg-panel-dark py-3 text-center font-source text-xs text-gray-300 hover:border-comic-yellow hover:text-off-white transition-all"
                    data-size={key}
                    style="box-shadow: 2px 2px 0 #000;">
                    {label}
                  </button>
                ))}
              </div>
            </div>

            <!-- Quantity -->
            <div class="mb-8">
              <h3 class="font-russo text-off-white text-sm uppercase tracking-wide mb-3">Quantity</h3>
              <div class="flex items-center gap-0">
                <button id="qty-dec" class="w-10 h-10 bg-panel-dark border-4 border-black text-off-white font-bold text-lg hover:bg-comic-red transition-colors">-</button>
                <span id="qty-display" class="w-12 h-10 bg-charcoal border-y-4 border-black text-off-white font-russo text-sm flex items-center justify-center">1</span>
                <button id="qty-inc" class="w-10 h-10 bg-panel-dark border-4 border-black text-off-white font-bold text-lg hover:bg-comic-red transition-colors">+</button>
              </div>
            </div>

            <!-- Add to Cart -->
            <button id="add-to-cart" class="btn-primary w-full text-xl text-center mb-4">
              ADD TO CART
            </button>

            {canCustomise && (
              <a
                id="customise-link"
                href={customiseHref}
                data-classic={customisable.classic ? '1' : ''}
                data-full-bleed={customisable.fullBleed ? '1' : ''}
                class="btn-secondary w-full text-lg text-center block mb-4"
              >
                ✏️ CUSTOMISE THIS DESIGN (+£{(customiseFee / 100).toFixed(2)})
              </a>
            )}
            {canCustomise && (
              <p id="customise-note" class="font-source text-gray-400 text-xs mb-4">
                Same artwork, your wording &mdash; the masthead, title, captions and colours.
                You&rsquo;ll approve a proof before we print.
              </p>
            )}
            </Fragment>
          )}

          {!product.isPersonalised && (
            <a href="/personalise" class="btn-secondary w-full text-xl text-center block mb-4">
              ✏️ MAKE IT PERSONAL — PUT YOURSELF IN THE FRAME
            </a>
          )}

          <!-- Delivery Info -->
          <div class="bg-panel-dark border-2 border-gray-700 p-4 flex flex-wrap gap-4">
            {[
              { icon: '🚚', text: 'Free UK P&P' },
              { icon: '🎨', text: 'Made to Order' },
              { icon: '⏱️', text: '3-6 Working Days' },
            ].map((item) => (
              <div class="flex items-center gap-2">
                <span class="text-lg">{item.icon}</span>
                <span class="font-russo text-gray-300 text-xs uppercase tracking-wide">{item.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {builderTemplate && (
        <div id="builder" class="mt-12">
          <h2 class="section-heading mb-3">BUILD YOUR ARTWORK</h2>
          <p class="font-source text-gray-400 text-sm mb-6 max-w-2xl">
            Drop your photos in, set your wording and choose your size. Download a draft to check
            it over before you order.
          </p>
          <ProductBuilder template={builderTemplate} mode="customer" personalisationFee={personalisationFee} />
        </div>
      )}
    </div>
  </section>

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="py-16 bg-panel-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-heading mb-8">YOU MIGHT ALSO LIKE</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProducts.map((p: any) => {
            const relImgUrl = p.images?.[0]?.asset ? urlFor(p.images[0]).width(600).height(400).url() : null;
            return (
              <a href={`/store/${p.slug}`} class="product-card group block">
                <div class="aspect-[3/2] overflow-hidden bg-mid-grey flex items-center justify-center">
                  {relImgUrl ? (
                    <img src={relImgUrl} alt={p.images[0]?.alt || p.title} class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-110" loading="lazy" />
                  ) : (
                    <span class="text-gray-500 font-russo tracking-widest text-xs uppercase">IMAGE</span>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="font-russo text-off-white text-sm group-hover:text-comic-yellow transition-colors">{p.title}</h3>
                  <span class="price-tag">From £{basePrice.toFixed(2)}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.title,
    "description": product.seo?.metaDescription || product.description,
    "image": mainImageUrl || undefined,
    "brand": { "@type": "Brand", "name": "Comic Strip Canvas" },
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": 9.99,
      "highPrice": 46.99,
      "priceCurrency": "GBP",
      "offerCount": 9,
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "Comic Strip Canvas" }
    }
  })}></script>

  <div id="product-data" class="hidden"
    data-product-id={product._id}
    data-product-slug={product.slug}
    data-product-title={product.title}
    data-product-accent={product.accentColor || '#EC008C'}
    data-product-image={mainImageUrl || ''}
    data-style-images={hasStyleChoice ? JSON.stringify(styleImages) : ''}
  ></div>

  <script>
    const PRICES = {
      poster: { small: 9.99, medium: 12.99, large: 16.99 },
      'canvas-standard': { small: 26.99, medium: 31.99, large: 44.99 },
      'canvas-gallery': { small: 28.99, medium: 33.99, large: 46.99 },
    };

    const dataEl = document.getElementById('product-data');
    const productId = dataEl?.dataset.productId || '';
    const productSlug = dataEl?.dataset.productSlug || '';
    const productTitle = dataEl?.dataset.productTitle || '';
    const productAccent = dataEl?.dataset.productAccent || '#EC008C';
    const productImage = dataEl?.dataset.productImage || '';

    let selectedFormat = 'poster';
    let selectedSize = 'small';
    let quantity = 1;

    /* Which artwork style is showing. Empty when the product has only one, and
       that emptiness is carried all the way to the cart line: a line with no
       style is a product with no choice, which is what every existing line and
       every existing order means. */
    const styleImages = (() => {
      try { return JSON.parse(dataEl?.dataset.styleImages || 'null'); }
      catch (e) { return null; }
    })();
    let selectedStyle = styleImages ? 'classic' : '';

    const priceEl = document.getElementById('current-price');
    const qtyDisplay = document.getElementById('qty-display');
    const formatBtns = document.querySelectorAll('.format-btn');
    const sizeBtns = document.querySelectorAll('.size-btn');
    const styleBtns = document.querySelectorAll('.style-btn');

    function updatePrice() {
      const price = PRICES[selectedFormat]?.[selectedSize] || 9.99;
      if (priceEl) priceEl.textContent = `£${(price * quantity).toFixed(2)}`;
    }

    function activateBtn(btns, activeEl, borderClass) {
      btns.forEach(b => {
        b.classList.remove(borderClass, 'text-off-white');
        b.classList.add('border-black', 'text-gray-300');
      });
      activeEl.classList.add(borderClass, 'text-off-white');
      activeEl.classList.remove('border-black', 'text-gray-300');
    }

    formatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        selectedFormat = (btn as HTMLElement).dataset.format || 'poster';
        activateBtn(formatBtns, btn, 'border-comic-yellow');
        updatePrice();
      });
    });

    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        selectedSize = (btn as HTMLElement).dataset.size || 'small';
        activateBtn(sizeBtns, btn, 'border-comic-yellow');
        updatePrice();
      });
    });

    /* Switching styles swaps the MAIN image and nothing else. The thumbnails
       below it are the gallery -- lifestyle mockups, detail shots, whatever
       somebody curated -- and they belong to the product rather than to either
       style, so they stay exactly where they are. The price does not move
       either: the two styles cost the same. */
    styleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.style || 'classic';
        const shot = styleImages?.[key];
        if (!shot?.url) return;
        selectedStyle = key;
        activateBtn(styleBtns, btn, 'border-comic-yellow');
        syncCustomiseLink();
        const mainImg = document.querySelector('#main-product-img') as HTMLImageElement;
        if (mainImg) { mainImg.src = shot.url; mainImg.alt = shot.alt || ''; }
        document.querySelectorAll('.thumb-btn').forEach(b =>
          b.classList.replace('border-comic-yellow', 'border-gray-700'));
      });
    });

    document.getElementById('qty-dec')?.addEventListener('click', () => {
      if (quantity > 1) {
        quantity--;
        if (qtyDisplay) qtyDisplay.textContent = String(quantity);
        updatePrice();
      }
    });

    document.getElementById('qty-inc')?.addEventListener('click', () => {
      quantity++;
      if (qtyDisplay) qtyDisplay.textContent = String(quantity);
      updatePrice();
    });

    /* The Customise link follows the style being shown: the two styles are two
       different designs, and only one of them may have a scene to reopen. */
    const customiseLink = document.getElementById('customise-link') as HTMLAnchorElement | null;
    const customiseNote = document.getElementById('customise-note') as HTMLElement | null;
    /* The two styles are two different designs and only one of them may have a
       scene, so the link follows the style being shown -- and is HIDDEN rather
       than repointed when the shown style has none. Sending somebody to the
       other style's design because this one cannot be customised would open a
       picture they were not looking at.

       Hidden with an inline display, not the hidden attribute: this element
       carries Tailwind's `block`, and `[hidden]` and `.block` have the same
       specificity, so which wins is decided by the order Tailwind happens to
       emit them in. (It is .hidden at byte 13265 against .block at 13067 in
       today's build, but that is a fact about a build, not a rule.) An inline
       style beats both, whatever the stylesheet does next. The attribute is set
       as well, for anything reading the page rather than painting it. */
    function syncCustomiseLink() {
      if (!customiseLink) return;
      const style = selectedStyle || 'classic';
      const has = style === 'fullBleed'
        ? !!customiseLink.dataset.fullBleed
        : !!customiseLink.dataset.classic;
      customiseLink.hidden = !has;
      customiseLink.style.display = has ? '' : 'none';
      if (customiseNote) customiseNote.style.display = has ? '' : 'none';
      if (!has) return;
      const base = customiseLink.getAttribute('href')?.split('?')[0] || '';
      customiseLink.href = style === 'fullBleed' ? `${base}?style=fullbleed` : base;
    }
    syncCustomiseLink();

    if (styleBtns[0]) activateBtn(styleBtns, styleBtns[0], 'border-comic-yellow');
    if (formatBtns[0]) activateBtn(formatBtns, formatBtns[0], 'border-comic-yellow');
    if (sizeBtns[0]) activateBtn(sizeBtns, sizeBtns[0], 'border-comic-yellow');
    // updatePrice() exists to reflect the selected format and size. Personalised
    // products have neither -- the builder owns pricing -- so it must not run and
    // overwrite the rendered "from" copy with a flat figure.
    if (formatBtns.length && sizeBtns.length) updatePrice();

    document.getElementById('add-to-cart')?.addEventListener('click', async () => {
      const { addToCart } = await import('../../stores/cart');
      const unitPrice = PRICES[selectedFormat]?.[selectedSize] || 9.99;
      addToCart({
        productId,
        slug: productSlug,
        title: productTitle,
        format: selectedFormat as any,
        size: selectedSize as any,
        quantity,
        unitPrice,
        accentColor: productAccent,
        // The basket shows the style that was chosen, not the product's default.
        imageUrl: (selectedStyle && styleImages?.[selectedStyle]?.url) || productImage,
        ...(selectedStyle ? { artworkStyle: selectedStyle as any } : {}),
      });
    });

    // Thumbnail click to swap main image
    document.querySelectorAll('.thumb-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mainImg = document.querySelector('#main-product-img') as HTMLImageElement;
        if (mainImg) {
          mainImg.src = (btn as HTMLElement).dataset.full || '';
          mainImg.alt = (btn as HTMLElement).dataset.alt || '';
        }
        document.querySelectorAll('.thumb-btn').forEach(b => b.classList.replace('border-comic-yellow', 'border-gray-700'));
        btn.classList.replace('border-gray-700', 'border-comic-yellow');
      });
    });

    // Lightbox zoom on main image click
    document.getElementById('main-image')?.addEventListener('click', () => {
      const mainImg = document.querySelector('#main-product-img') as HTMLImageElement;
      if (!mainImg?.src) return;

      const overlay = document.createElement('div');
      overlay.className = 'fixed inset-0 z-[9999] flex items-center justify-center p-4 cursor-zoom-out';
      overlay.style.backgroundColor = 'rgba(0,0,0,0.92)';
      overlay.innerHTML = `
        <img src="${mainImg.src}" alt="${mainImg.alt}" class="max-w-full max-h-full object-contain" />
        <button class="absolute top-4 right-4 text-white hover:text-comic-yellow transition-colors">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      `;
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      overlay.addEventListener('click', () => {
        overlay.remove();
        document.body.style.overflow = '';
      });
    });
  </script>

  <style>
    .scrollbar-thin::-webkit-scrollbar {
      height: 6px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
      background: #1A1A1A;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: #444;
      border-radius: 3px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
      background: #EC008C;
    }
  </style>
</BaseLayout>
