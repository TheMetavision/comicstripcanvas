---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartPanel from '../components/CartPanel.astro';
import CookieConsent from '../components/consent/CookieConsent.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import '../styles/global.css';
import { sizeLabel } from '../../netlify/functions/_shared/sizes.mjs';
import { organizationSchema } from '../lib/schema';
import { SITE, canonicalUrl } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  /** Staff pages (/admin): no cookie banner and no Google Analytics. */
  noTracking?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://cdn.sanity.io/images/lwbwahym/production/ea1e54dd3477bbbfbf2a13a8761a048a6a2f30b6-2752x1536.jpg?w=1200',
  ogType = 'website',
  canonical,
  noindex = false,
  noTracking = false,
} = Astro.props;

const siteUrl = SITE;
// Apex host, trailing slash: the address Netlify actually serves.
const pageUrl = canonicalUrl(canonical || Astro.url.pathname);
// Titles stay within 60 characters: the brand suffix is dropped before the
// page's own words are. Descriptions over 155 are trimmed at a word boundary
// (a safety net; templates should fit) and never left empty.
const TITLE_MAX = 60;
const DESC_MAX = 155;
const DEFAULT_DESCRIPTION = 'Bold comic-book style wall art: canvas prints and posters of film, music and sport legends, or personalised from your own photos. Made to order in the UK.';
const bareTitle = title.replace(/\s*\|\s*Comic Strip Canvas\s*$/, '');
const fullTitle = `${bareTitle} | Comic Strip Canvas`.length <= TITLE_MAX ? `${bareTitle} | Comic Strip Canvas` : bareTitle;
function fitDescription(d: string): string {
  const clean = d.replace(/\s+/g, ' ').trim();
  if (clean.length <= DESC_MAX) return clean;
  const cut = clean.slice(0, DESC_MAX - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:—–-]+$/, '') + '…';
}
const metaDescription = fitDescription(description || DEFAULT_DESCRIPTION);

// Breadcrumb from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'Home', url: `${siteUrl}/` },
  ...pathSegments.map((seg, i) => ({
    name: seg.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    /* With the trailing slash, so a breadcrumb names the address the page is
       actually served at -- the same one the canonical gives. */
    url: `${siteUrl}/${pathSegments.slice(0, i + 1).join('/')}/`,
  })),
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={pageUrl} />
  <meta name="author" content="Comic Strip Canvas" />
  <meta name="geo.region" content="GB" />
  <meta name="geo.country" content="GB" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content="Comic Strip Canvas" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Organization schema: the real trader (src/lib/schema.ts) -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema(`${siteUrl}/web-app-manifest-512x512.png`))}></script>

  <!-- BreadcrumbList Schema (all pages) -->
  {breadcrumbItems.length > 1 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url,
      })),
    })}></script>
  )}

  <!-- WebSite schema. No SearchAction: the store ignores ?q=. -->
  {Astro.url.pathname === '/' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Comic Strip Canvas",
      "url": canonicalUrl('/'),
      "publisher": { "@id": canonicalUrl('/') + '#organization' },
    })}></script>
  )}

  <!-- FAQPage Schema (/personalise/) -->
  {Astro.url.pathname === '/personalise/' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does the personalised service work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose your style, then drop your photos straight into the template and arrange them yourself — you see your layout on screen as you build it. Add your text, pick your colours, choose your size and format, then order. The comic artwork is applied automatically and your finished artwork is emailed to you for approval before anything is printed."
          }
        },
        {
          "@type": "Question",
          "name": "What sizes are available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `We offer three sizes: ${sizeLabel('small', 'x')}, ${sizeLabel('medium', 'x')}, and ${sizeLabel('large', 'x')}. All sizes are available as Poster Prints, Canvas Standard Frame, and Canvas Gallery Frame.`
          }
        },
        {
          "@type": "Question",
          "name": "What styles can I choose from?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer three distinct styles: Comic Book Covers (bold, dramatic panel-style covers), Comic Book Icons (pop-art inspired graphic portraits), and Comic Book Strips (multi-panel sequential storytelling). Each style is also available as a ready-made design or fully personalised with your own photos."
          }
        },
        {
          "@type": "Question",
          "name": "Will I get to see a proof before you print?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Twice over. You see your layout immediately while you build it, so you know exactly where every photo and every word sits. After you order, we check the finished artwork and email it to you — usually within one working day. Nothing goes to print until you approve it."
          }
        },
        {
          "@type": "Question",
          "name": "How long does delivery take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For personalised items, please allow 3-6 working days from proof approval. For standard (non-personalised) prints, allow 3-5 working days. All orders are sent via tracked delivery. You'll receive a tracking number when your order ships."
          }
        },
        {
          "@type": "Question",
          "name": "Do you ship internationally?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Currently we ship to UK addresses only, at one price wherever you are. FREE P&P on orders of £50 and over, otherwise £4.95 flat-rate UK delivery. We're working on expanding to Europe and further afield — sign up to our newsletter to be notified when international shipping launches."
          }
        },
        {
          "@type": "Question",
          "name": "What is your returns policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because our products are made to order, we cannot accept returns unless the item is faulty or damaged. If your order arrives damaged, please contact us within 48 hours with photos and we'll arrange a replacement. Personalised items cannot be returned unless they arrive with a printing defect."
          }
        },
        {
          "@type": "Question",
          "name": "What photo do I need to send for a personalised comic canvas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The bigger the file the better. Photos straight from a phone or camera are ideal; screenshots and pictures saved from social media are usually too small. JPG, PNG and WEBP are all fine. The builder shows the print quality of each photo as you position it and warns you before anything would print soft, so you never have to guess. The pose in your photo is the pose in your artwork — if your subject is facing away or mid-action, that is exactly how it will appear in your artwork. Covers and Icons take one photo. Strips need a photo in all twelve panels — you can use the same photo more than once if you want to."
          }
        }
      ]
    })}></script>
  )}
</head>
<body class="min-h-screen flex flex-col">
  <!-- Google Analytics 4 (G-LH10709LC0) loads from here only after "Accept all".
       Staff pages (noTracking) get neither the banner nor analytics. -->
  {!noTracking && (
    <CookieConsent
      ga4="G-LH10709LC0"
      policyUrl="/privacy-policy/"
      cookieName="csc_consent"
      purpose="We’d like to use Google Analytics 4 to measure site visits and shopping steps (viewing products, adding to your bag, starting checkout, purchases). It stays off unless you accept. Your basket and checkout work either way."
    />
  )}

  <Navbar />
  <main class="flex-1 pt-24 lg:pt-28">
    {!noTracking && <AnnouncementBar />}
    <slot />
  </main>
  <Footer cookieSettings={!noTracking} />
  <CartPanel />

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );
    reveals.forEach((el) => observer.observe(el));
  </script>
</body>
</html>
