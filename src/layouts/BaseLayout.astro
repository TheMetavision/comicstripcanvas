---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartPanel from '../components/CartPanel.astro';
import CookieConsent from '../components/consent/CookieConsent.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import '../styles/global.css';
import { sizeLabel } from '../../netlify/functions/_shared/sizes.mjs';
import { organizationSchema } from '../lib/schema';
import { SITE, canonicalUrl } from '../lib/url';
import { getSeasonal } from '../lib/seasonal';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  /** Staff pages (/admin): no cookie banner and no Google Analytics. */
  noTracking?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://cdn.sanity.io/images/lwbwahym/production/ea1e54dd3477bbbfbf2a13a8761a048a6a2f30b6-2752x1536.jpg?w=1200',
  ogType = 'website',
  canonical,
  noindex = false,
  noTracking = false,
} = Astro.props;

const { campaign: season } = await getSeasonal();

const siteUrl = SITE;
// Apex host, trailing slash: the address Netlify actually serves.
const pageUrl = canonicalUrl(canonical || Astro.url.pathname);
// Titles stay within 60 characters: the brand suffix is dropped before the
// page's own words are. Descriptions over 155 are trimmed at a word boundary
// (a safety net; templates should fit) and never left empty.
const TITLE_MAX = 60;
const DESC_MAX = 155;
const DEFAULT_DESCRIPTION = 'Bold comic-book style wall art: canvas prints and posters of film, music and sport legends, or personalised from your own photos. Made to order in the UK.';
const bareTitle = title.replace(/\s*\|\s*Comic Strip Canvas\s*$/, '');
const fullTitle = `${bareTitle} | Comic Strip Canvas`.length <= TITLE_MAX ? `${bareTitle} | Comic Strip Canvas` : bareTitle;
function fitDescription(d: string): string {
  const clean = d.replace(/\s+/g, ' ').trim();
  if (clean.length <= DESC_MAX) return clean;
  const cut = clean.slice(0, DESC_MAX - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:—–-]+$/, '') + '…';
}
const metaDescription = fitDescription(description || DEFAULT_DESCRIPTION);

// Breadcrumb from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'Home', url: `${siteUrl}/` },
  ...pathSegments.map((seg, i) => ({
    name: seg.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    /* With the trailing slash, so a breadcrumb names the address the page is
       actually served at -- the same one the canonical gives. */
    url: `${siteUrl}/${pathSegments.slice(0, i + 1).join('/')}/`,
  })),
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {season && (
    <>
      <meta name="csc-season" data-start={season.startDate} data-end={season.endDate} />
      {/* Before paint: <html data-season="on"> inside [start, end). ?season=on|off overrides, for testing.
          If this fails the attribute stays off and the normal hero shows. */}
      <script is:inline>(function(){try{var m=document.querySelector('meta[name="csc-season"]'),q=/[?&]season=(on|off)(?:&|$)/.exec(location.search),n=Date.now(),on=q?q[1]==='on':n>=Date.parse(m.dataset.start)&&n<Date.parse(m.dataset.end);if(on)document.documentElement.dataset.season='on'}catch(e){}})();</script>
    </>
  )}
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={pageUrl} />
  <meta name="author" content="Comic Strip Canvas" />
  <meta name="geo.region" content="GB" />
  <meta name="geo.country" content="GB" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content="Comic Strip Canvas" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Organization schema: the real trader (src/lib/schema.ts) -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema(`${siteUrl}/web-app-manifest-512x512.png`))}></script>

  <!-- BreadcrumbList Schema (all pages) -->
  {breadcrumbItems.length > 1 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url,
      })),
    })}></script>
  )}

  <!-- WebSite schema. No SearchAction: the store ignores ?q=. -->
  {Astro.url.pathname === '/' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Comic Strip Canvas",
      "url": canonicalUrl('/'),
      "publisher": { "@id": canonicalUrl('/') + '#organization' },
    })}></script>
  )}

  <!-- /personalise/ FAQPage comes from the page's own visible FAQ (personalise.astro), so it always matches what visitors see. -->
</head>
<body class="min-h-screen flex flex-col">
  <!-- Google Analytics 4 (G-LH10709LC0) loads from here only after "Accept all".
       Staff pages (noTracking) get neither the banner nor analytics. -->
  {!noTracking && (
    <CookieConsent
      ga4="G-LH10709LC0"
      policyUrl="/privacy-policy/"
      cookieName="csc_consent"
      purpose="We’d like to use Google Analytics 4 to measure site visits and shopping steps (viewing products, adding to your bag, starting checkout, purchases). It stays off unless you accept. Your basket and checkout work either way."
    />
  )}

  <Navbar />
  <main class="flex-1 pt-24 lg:pt-28">
    {!noTracking && <AnnouncementBar />}
    <slot />
  </main>
  <Footer cookieSettings={!noTracking} />
  <CartPanel />

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );
    reveals.forEach((el) => observer.observe(el));
  </script>
</body>
</html>
